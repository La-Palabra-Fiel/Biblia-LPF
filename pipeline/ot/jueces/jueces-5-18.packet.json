  "editorialLexicalPolicy": [
    {
      "id": "ot-nephesh",
      "status": "binding-options",
      "authority": "named-human-editorial-policy",
      "evidenceBoundary": "Spanish realization options and constraints only. These entries never override source surface, morphology, syntax, discourse, or canonical corpus evidence.",
      "instruction": "Choose the Spanish realization of nephesh from its construction and participants. Alma remains permitted but is never automatic; do not import immortality, separability, or a body-soul contrast that the source does not express.",
      "spanishOptions": [
        {
          "form": "ser viviente/criatura viviente",
          "when": "The construction identifies a whole living human or animal, especially with the living-creature expression."
        },
        {
          "form": "persona/individuo",
          "when": "Human beings are counted, identified as members of a group, or referred to as whole persons."
        },
        {
          "form": "vida",
          "when": "Life is killed, preserved, endangered, sought, surrendered, or recovered."
        },
        {
          "form": "alma",
          "when": "The construction concerns the inner person, personal identity, desire, or a contrast that this established Spanish term preserves accurately."
        },
        {
          "form": "ánimo/ser/yo/deseo",
          "when": "The syntax and discourse specifically require one of these contextual relations and natural Spanish supports it."
        }
      ],
      "avoid": [
        "using alma as an automatic gloss",
        "using vida or persona as an automatic replacement",
        "adding immortality or separability without source evidence",
        "merging nephesh with neshamah or ruach"
      ],
      "activeReferenceRules": []
    }
  ],
  "editorialLexicalPolicyReview": [
