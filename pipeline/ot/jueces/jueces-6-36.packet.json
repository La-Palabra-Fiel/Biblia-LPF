  "editorialLexicalPolicy": [
    {
      "id": "ot-yesha-salvation-family",
      "status": "approved-options",
      "authority": "named-human-editorial-policy",
      "evidenceBoundary": "Spanish realization options and constraints only. These entries never override source surface, morphology, syntax, discourse, or canonical corpus evidence.",
      "instruction": "Choose the Spanish realization from the danger, agent, patient, result, and horizon expressed by the construction. Salvación and salvar remain valid options but are never automatic glosses. Preserve who saves whom, from what, and with what result; do not add guilt, eternity, heaven, works, or a doctrinal condition not expressed by the source.",
      "spanishOptions": [
        {
          "form": "salvación/salvar",
          "when": "The context presents God's comprehensive intervention, judgment, restored relation, future hope, or a rescue whose scope should not be reduced to one immediate effect; these forms may also be used for physical danger when they are the clearest natural Spanish."
        },
        {
          "form": "rescatar/librar/poner a salvo",
          "when": "Immediate danger, enemies, death, captivity, or extraction from peril is foregrounded."
        },
        {
          "form": "preservar/conservar/sobrevivir",
          "when": "Continuity, survival, preservation, or remaining alive is foregrounded."
        }
      ],
      "avoid": [
        "using salvación or salvar as an automatic gloss",
        "adding guilt, eternity, heaven, works, or a doctrinal condition without source evidence",
        "merging this family with malat, palat, or natsal merely because Spanish options overlap",
        "omitting the expressed danger, agent, patient, or result"
      ],
