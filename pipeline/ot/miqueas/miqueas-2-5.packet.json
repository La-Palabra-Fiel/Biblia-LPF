        {
          "form": "asamblea",
          "when": "The people are summoned or gathered for a concrete event, deliberation, covenant act, judgment, worship, or hearing."
        },
        {
          "form": "congregación",
          "when": "The source designates the identifiable body of people rather than only the meeting event."
        }
      ],
