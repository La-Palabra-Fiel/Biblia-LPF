      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωθῆναι",
      "normalizedSurface": "σωθηναι",
      "matchedNormalizedPrefix": "σωθηναι",
      "immediateContext": "ὅθεν οὐδεὶς ἂν προσεδόκησεν ἐμὲ σωθῆναι χωρὶς ὑμῶν δι’ εὐνοίας ὑπερβολήν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "40.36",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζεσθαι",
      "normalizedSurface": "σωιζεσθαι",
      "matchedNormalizedPrefix": "σωιζεσθαι",
      "immediateContext": "σκοπεῖτε γάρ, εἰ καί τισι δόξει μετέωρος ὁ, λόγος καὶ οὐ πάνυ τι ὑμῖν συμπαθής, ὅτι ταῦτα πεφυκότα ἄφθαρτα καὶ θεῖα καὶ τοῦ πρώτου καὶ μεγίστου γνώμῃ καὶ δυνάμει κυβερνώμενα θεοῦ τὸν ἅπαντα χρόνον ἐκ τῆς πρὸς ἄλληλα φιλίας καὶ ὁμονοίας σῴζεσθαι φιλεῖ, τά τε ἰσχυρότερα καὶ μείζω καὶ τὰ ἐλάττω δὴ δοκοῦντα."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "48.7",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίας",
      "normalizedSurface": "σωτηριασ",
      "matchedNormalizedPrefix": "σωτηριασ",
      "immediateContext": "ὥσπερ γὰρ ἐν μιᾷ νηὶ πλέοντας οὐ δυνατὸν οἶμαι χωρὶς ἕκαστον σωτηρίας τυγχάνειν, ἀλλ’ ἅμα πάντας, οὕτως οὐδὲ τοὺς συμπολιτευομένους."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "48.9",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζειν",
      "normalizedSurface": "σωιζειν",
      "matchedNormalizedPrefix": "σωιζειν",
      "immediateContext": "καὶ δεῖ προνοεῖν καὶ σῴζειν, οὐ μέντοι μετὰ ἔχθρας οὐδὲ μετὰ διαφορᾶς."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "59.1",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίας",
      "normalizedSurface": "σωτηριασ",
      "matchedNormalizedPrefix": "σωτηριασ",
      "immediateContext": "καίτοι ποία τις ἡ τοιαύτη σοφία καὶ φρόνησις, δι’ ἥν τις ἀναγκάζεται πλείω τῶν ἄλλων πονεῖν ὑπὲρ τῆς κοινῆς σωτηρίας καὶ νίκης, ἐξὸν ἕνα τοῦ πλήθους δοκοῦντα μηδενὸς ἔλαττον ἐν τούτοις ἔχειν τῶν ἀρίστων;"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "59.5",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίαν",
      "normalizedSurface": "σωτηριαν",
      "matchedNormalizedPrefix": "σωτηριαν",
      "immediateContext": "ἀλλὰ σὺ ἄμυνον, ὦ δεσποινα Ἀθηνᾶ, καὶ μὴ μάτην φανῇς ἡμῖν ὑποσχομένη τὴν σωτηρίαν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "59.9",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίας",
      "normalizedSurface": "σωτηριασ",
      "matchedNormalizedPrefix": "σωτηριασ",
      "immediateContext": "ὥσπερ ἀμέλει κἀμὲ ἐξέθηκας, ὑπὲρ τῆς κοινῆς σωτηρίας τε καὶ νίκης περιπεσόντα τῇδε τῇ ξυμφορᾷ, δεικνύντα τὸν Χρύσης βωμόν, οὗ θύσαντες κρατήσειν ἔμελλον τῶν πολεμίων·"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "59.11",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρία",
      "normalizedSurface": "σωτηρια",
      "matchedNormalizedPrefix": "σωτηρια",
      "immediateContext": "εἰ δὲ δὴ τοῦδ’ ἐθελήσεις κοινωνεῖν τοῦ βίου μεθ’ ἡμῶν ἐνθάδε, ἕως ἂν ἑτέρα σοι παραπέσῃ σωτηρία ποθέν, οὐκ ἂν φθονοῖμεν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "64.5",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζει",
      "normalizedSurface": "σωιζει",
      "matchedNormalizedPrefix": "σωιζει",
      "immediateContext": "πότερον ὡς μάλιστα τῶν πλεόντων τῆς τύχης δεομένων, ἢ διότι τὸν βίον ἡμῶν ὥς τινα μεγάλην ναῦν κυβερνᾷ καὶ πάντας σῴζει τοὺς ἐμπλέοντας;"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "64.10",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζει",
      "normalizedSurface": "σωιζει",
      "matchedNormalizedPrefix": "σωιζει",
      "immediateContext": "οὔτε γὰρ πίττῃ τὴν ψυχὴν οὔτε σχοινίοις ἐπιτρέπουσιν οὔτε τριδάκτυλον αὐτοὺς σῴζει ξύλον πεύκινον, ἀλλ’ ἐπέτρεψαν βεβαίῳ καὶ μεγάλῳ πράγματι τῇ τύχῃ."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "64.10",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζει",
      "normalizedSurface": "σωιζει",
      "matchedNormalizedPrefix": "σωιζει",
      "immediateContext": "αὕτη σῴζει καὶ τὸν νοσοῦντα ἐν τῷ τέλει καὶ τὸν νηχόμενον ἐν τῇ θαλάσσῃ καὶ τὸν Ἀγαμέμνονα ἐπὶ τῶν χιλίων νεῶν καὶ τὸν Ὀδυσσέα ἐπὶ τῆς σχεδίας φερόμενον."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "73.7",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "ἐσώθη",
      "normalizedSurface": "εσωθη",
      "matchedNormalizedPrefix": "εσωθη",
      "immediateContext": "καὶ εἰ μὲν ἀποβαλὼν τὴν στρατιὰν ἢ μέρος αὐτῆς αὐτὸς γοῦν ἐσώθη, δῆλον ὅτι οἴκοι ἀφικόμενος ἀπολώλει ἂν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "73.8",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωθῆναι",
      "normalizedSurface": "σωθηναι",
      "matchedNormalizedPrefix": "σωθηναι",
      "immediateContext": "σχεδὸν γὰρ τό γε σωθῆναι ἐκείνους ἀδύνατόν ἐστιν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "74.7",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίαν",
      "normalizedSurface": "σωτηριαν",
      "matchedNormalizedPrefix": "σωτηριαν",
      "immediateContext": "διὰ τοῦτο πιστεύειν δεῖ καὶ μήτε ἀγκύρας ἔχοντα μήτε πηδάλιον μήτε τἄλλα τὰ πρὸς τὴν σωτηρίαν ἀνάγεσθαί ποτε;"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "74.17",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "ἐσώθη",
      "normalizedSurface": "εσωθη",
      "matchedNormalizedPrefix": "εσωθη",
      "immediateContext": "τοιγαροῦν πρότερον, ὁπότε οὐδέπω μετειλήφει τῆς παρ’ αὐτῷ τροφῆς, εἰς Λῆμνον ἀπεμποληθεὶς ἐσώθη·"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "75.1",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτηρίας",
      "normalizedSurface": "σωτηριασ",
      "matchedNormalizedPrefix": "σωτηριασ",
      "immediateContext": "οἱ μὲν οὖν τοῦτον φυλάττοντες ἔχονται τῆς σωτηρίας·"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "75.10",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωθῆναι",
      "normalizedSurface": "σωθηναι",
      "matchedNormalizedPrefix": "σωθηναι",
      "immediateContext": "τοσούτῳ δὲ ταῖς πόλεσι χρησιμώτερός ἐστιν ἤπερ τὰ πηδάλια ταῖς ναυσίν, ὥστε ἡ μὲν ἀποβαλοῦσα τοὺς οἴακας ναῦς οὐκ ἂν ἀπόλοιτο μὴ χειμῶνος καταλαβόντος, πόλιν δ’ οὐκ ἔνι σωθῆναι τοῦ νόμου λυθέντος, οὐδ’ ἂν μηδὲν ἔξωθεν συμβαίνῃ δεινόν."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "75.10",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζεται",
      "normalizedSurface": "σωιζεται",
      "matchedNormalizedPrefix": "σωιζεται",
      "immediateContext": "ὥσπερ δὲ ὑπὸ τῆς ἐν αὐτῷ διανοίας διοικεῖται καὶ σῴζεται τῶν ἀνθρώπων ἕκαστος, ἡ δὲ ταύτης διαφθορὰ μανίαν καὶ παρακοπὴν φέρει, παραπλησίως, ἄν τις ἀνέλῃ τὸν νόμον ἐκ τοῦ βίου, καθάπερ οἶμαι τὸν νοῦν ἀπολωλεκὼς εἰς παντελῆ μανίαν καὶ ταραχὴν περιστήσεται."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "77_78.9",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωτῆρα",
      "normalizedSurface": "σωτηρα",
      "matchedNormalizedPrefix": "σωτηρα",
      "immediateContext": "ἐὰν δὲ φανῇ τις, κατὰ τὸν Ἡσίοδον κοτέειν μέλλει καὶ ἐχθρὸν ἡγεῖσθαι τὸν αὑτοῦ σωτῆρα καὶ τῶν φιλτάτων;"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "80.6",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῴζειν",
      "normalizedSurface": "σωιζειν",
      "matchedNormalizedPrefix": "σωιζειν",
      "immediateContext": "τὸν οὖν ἐπιχειροῦντα τοῦτον σῴζειν ὡς ἂν οἷός τε ᾖ καὶ τό γε καθ’ αὑτὸν φυλάττειν οὐδέποτε ἂν μὴ φρονεῖν φαίην ἔγωγε."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "80.9",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σωθῆναι",
      "normalizedSurface": "σωθηναι",
      "matchedNormalizedPrefix": "σωθηναι",
      "immediateContext": "ὅθεν οὐ νημάτων ἔστι λεπτῶν εὐπορήσαντας ἐξελθεῖν βοηθείᾳ κόρης ἄφρονος, ὥσπερ ἐκεῖνον Θησέα φασὶν ἐκ Κρήτης σωθῆναι, αὐτῆς οἶμαι τῆς Ἀθηνᾶς παρισταμένης καὶ σῳζούσης ἅμα."
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "85.17",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "ἐσώθη",
      "normalizedSurface": "εσωθη",
      "matchedNormalizedPrefix": "εσωθη",
      "immediateContext": "τὸν δὲ Καλλίου υἱόν, εἴπερ ὄντως ἐσώθη τότε ἁλούς, ἀφικόμενον ἐκ Θρᾴκης, συχνὰ ἔτη γεγονότα ἐκεῖ καὶ πολλάκις μεμαστιγωμένον οὐδεὶς ἂν ἠξίου τῆς πολιτείας ἀπελαύνειν·"
    },
    {
      "source": "perseus-dio-chrysostom",
      "work": "Orationes",
      "editionUrn": "urn:cts:greekLit:tlg0612.tlg001.perseus-grc2",
      "passage": "27.8",
      "path": "data/tlg0612/tlg001/tlg0612.tlg001.perseus-grc2.xml",
      "surface": "σῳζομένων",
      "normalizedSurface": "σωιζομενων",
      "matchedNormalizedPrefix": "σωιζομενων",
      "immediateContext": "αὐτίκα τὸν εὐτυχοῦντα, ὁποίαν τινά φασιν οἱ πολλοὶ τὴν εὐτυχίαν, οἷον χρήματα ἐκ δανείων πολλὰ ἢ χώραν ἱκανὴν κεκτημένον καὶ αὐτὸν ὑγιαίνοντα τέκνων σῳζομένων καὶ γυναικός, καί τινα δύναμιν καὶ ἀρχὴν ἔχοντα μεγάλην ἄνευ πολέμου καὶ στάσεως καί τινων φανερῶν κινδύνων, οὐκ ἂν εὕροι τις ῥᾳδίως προσιόντα τοῖς τοιούτοις οὐδὲ ἀξιοῦντα κοινωνεῖν τῶν ἐκ φιλοσοφίας λόγων."
    }
  ]
