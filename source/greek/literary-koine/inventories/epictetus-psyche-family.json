      "normalizedSurface": "ψυχη",
      "matchedNormalizedPrefix": "ψυχη",
      "immediateContext": "μή τι ἄλλο τι μέλλει γίνεσθαι ἢ τὸ σωμάτιον χωρίζεσθαι καὶ ἡ ψυχή;"
    },
    {
      "source": "perseus-epictetus",
      "work": "Ἀρριανοῦ τῶν Ἐπικτήτου Διατριβῶν",
      "editionUrn": "urn:cts:greekLit:tlg0557.tlg001.perseus-grc2",
